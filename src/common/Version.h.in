/**
 * @file Version.h.in
 * @brief CMake template for compiled run provenance.
 *
 * Purpose:
 *   Embed the source revision, project version, checkout location, and protected
 *   target-geometry hash in the binaries that create completed run manifests.
 *
 * Workflow:
 *   CMake substitutes every @...@ token while configuring the build. LundWriter
 *   then copies the resulting constants into each completed manifest.
 *
 * Inputs and outputs:
 *   Inputs come from CMake project metadata, Git, and the SHA-256 calculation for
 *   targets.h. The generated output is build/generated/Version.h.
 */

#pragma once

// Compiled provenance ---------------------------------------------------------------------------------------------------------------------------------------------------

#pragma region /* Compiled provenance */

/** @brief Git description of the configured source checkout. */
#define SAMPLE_REVISION "@SAMPLE_REVISION@"

/** @brief Project version declared by the root CMake project. */
#define SAMPLE_VERSION "@PROJECT_VERSION@"

/** @brief Absolute source checkout used when the build was configured. */
#define SAMPLE_SOURCE_DIR "@PROJECT_SOURCE_DIR@"

/** @brief SHA-256 digest of the protected target-geometry header. */
#define SAMPLE_TARGETS_SHA256 "@SAMPLE_TARGETS_SHA256@"

#pragma endregion
