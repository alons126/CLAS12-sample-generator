# Repository ignore rules -----------------------------------------------------
# Purpose:
#   Keep maintained source and shared configuration under version control while
#   excluding generated, machine-local, and disposable files.
#
# How these rules are used:
#   A leading `/` pins a rule to the repository root. Simple names can match at
#   any depth, while multi-part paths are relative to this file. Git continues
#   to report changes to tracked files even when a later rule matches their path.

# Build and interpreter artifacts --------------------------------------------
# Ignore compiled libraries, dependency metadata, ROOT dictionaries, and Python
# bytecode. ROOT data files remain eligible for version control when needed.
# *.root
*.so
*.pcm
*.d
*.pyc
__pycache__/

# Simulation and batch-job products ------------------------------------------
# Detector events, reconstructed data, and captured batch output are generated
# by local or ifarm workflows and can be large.
*.ev
*.hipo
*.out

# Generated working directories ----------------------------------------------
# Build trees, temporary workspaces, run directories, and general output are
# disposable products of development and workflow execution.
build/
tmp/
/runs/
output/

# Machine-local configuration -------------------------------------------------
# Keep per-user CMake presets and run overrides separate from reviewed shared
# defaults.
/CMakeUserPresets.json
/config/run.local.json

# Editor and operating-system files ------------------------------------------
# Ignore editor backups and macOS directory metadata wherever they appear.
*~
*#
.DS_Store

# Project test code -----------------------------------------------------------
# Test implementations and fixtures below `src` are local development material.
# Keep them on disk but outside Git tracking and published source archives.
/src/**/tests/

# Local samples and tutorial working copies ----------------------------------
# Ignore generated comparison runs and personal copies of tutorial commands.
legacy/GENIE-GST-test-samples/test-runs
legacy/GENIE-GST-test-samples/*.root
tutorials/uniform-samples/uniform-lund-creation copy.txt
tutorials/uniform-samples/uniform-slurm-submission copy.txt

# Historical compatibility ----------------------------------------------------
# Retain the old converter path rule for its generated ACLiC dependency file.
GEMC-samples/GENIE_to_LUND_converter/GENIE_to_LUND_converter_C.d
